{
  "name": "opencode-remote-code",
  "version": "3.0.1",
  "description": "OpenCode plugin that lets AI agents edit and run commands on a remote machine over SSH — Windows (OpenSSH + PowerShell) or POSIX — with zero footprint on the remote side",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "index.js"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/postbuild.cjs",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "node test/run-tests.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.1.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.1.2",
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vibed-this/opencode-remote-code.git"
  },
  "bugs": {
    "url": "https://github.com/vibed-this/opencode-remote-code/issues"
  },
  "homepage": "https://github.com/vibed-this/opencode-remote-code#readme",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "ssh",
    "remote",
    "agent",
    "sftp",
    "windows",
    "openssh",
    "powershell",
    "posix"
  ]
}
